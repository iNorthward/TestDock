# Generic test platform: independent project, no business credentials.
PLATFORM_PACKS=demo_pack
PLATFORM_PANEL_PORT=8801
PLATFORM_PACK_DATA_DIR=data/demo
PLATFORM_ARTIFACT_ROOT=artifacts
TZ=Asia/Shanghai

# MySQL pools are lazy; connection credentials belong to the selected Pack.
PLATFORM_DB_POOL_ENABLED=1
PLATFORM_DB_POOL_SIZE=5
PLATFORM_DB_POOL_MAX_OVERFLOW=5
PLATFORM_DB_POOL_TIMEOUT=5
PLATFORM_DB_POOL_RECYCLE=1800
